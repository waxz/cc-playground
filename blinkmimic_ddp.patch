index 0000000..e321415
--- /dev/null
+++ b/tools/launch_ddp.py
@@ -0,0 +1,63 @@
+"""Launch data-parallel BlinkMimic training: one process per GPU, each restricted to its own device.
+
+    python tools/launch_ddp.py --nproc 2 -- <args of blinkmimic.train>
+
+If any rank exits (error or normal end) the others are given a short grace period and then killed, so a failed rank can never
+leave the remaining GPUs hanging in a collective. Exit code: 0 only if every rank exited 0.
+"""
+
+import argparse
+import os
+import signal
+import socket
+import subprocess
+import sys
+import time
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--nproc", type=int, default=2)
+ap.add_argument("--grace", type=float, default=30.0, help="seconds the other ranks get after the first one exits")
+ap.add_argument("--done_file", default=None, help="written by rank 0 when training and all checkpoints are finished; once it exists the\n                 ranks get --grace seconds to exit, then are killed, and the launch counts as a success")
+ap.add_argument("rest", nargs=argparse.REMAINDER)
+a = ap.parse_args()
+rest = a.rest[1:] if a.rest and a.rest[0] == "--" else a.rest
+
+with socket.socket() as s:
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if a.done_file and os.path.exists(a.done_file):
+    os.remove(a.done_file)
+procs = []
+for r in range(a.nproc):
+    env = dict(os.environ, RANK=str(r), WORLD_SIZE=str(a.nproc), LOCAL_RANK="0", MASTER_ADDR="127.0.0.1", MASTER_PORT=str(port),
+               CUDA_VISIBLE_DEVICES=str(r), PYTHONPATH=os.path.join(root, "src") + os.pathsep + os.environ.get("PYTHONPATH", ""),
+               TORCH_NCCL_ASYNC_ERROR_HANDLING="0", TORCH_NCCL_AVOID_RECORD_STREAMS="1", NCCL_ASYNC_ERROR_HANDLING="0")
+    procs.append(subprocess.Popen([sys.executable, "-u", "-m", "blinkmimic.train", *rest], env=env, cwd=root))
+
+
+def kill_all(*_):
+    for p in procs:
+        if p.poll() is None:
+            p.kill()
+
+
+signal.signal(signal.SIGTERM, lambda *_: (kill_all(), sys.exit(143)))
+first_done = None
+while True:
+    codes = [p.poll() for p in procs]
+    if all(c is not None for c in codes):
+        break
+    if first_done is None and a.done_file and os.path.exists(a.done_file):
+        first_done = time.time()
+        print(f"[launch_ddp] done file found; killing remaining ranks in {a.grace:.0f} s", flush=True)
+    if first_done is None and any(c is not None for c in codes):
+        first_done = time.time()
+        print(f"[launch_ddp] a rank exited with {codes}; killing the rest in {a.grace:.0f} s", flush=True)
+    if first_done is not None and time.time() - first_done > a.grace:
+        kill_all()
+    time.sleep(1)
+codes = [p.returncode for p in procs]
+print(f"[launch_ddp] exit codes {codes}", flush=True)
+ok = all(c == 0 for c in codes) or bool(a.done_file and os.path.exists(a.done_file))  # killed after a finished run still counts
+sys.exit(0 if ok else 1)
