@@ -21,6 +21,7 @@ def mlp(inp: int, hidden: list[int], out: int, act=nn.ELU, layer_norm: bool = Fa
     return nn.Sequential(*layers)
 
 
+
 class RunningNorm(nn.Module):
     """Running mean/std normalizer; updated from data without gradients, frozen after ``max_count``."""
 
@@ -30,6 +31,7 @@ class RunningNorm(nn.Module):
         self.register_buffer("var", torch.ones(dim))
         self.register_buffer("count", torch.zeros(()))
         self.max_count, self.eps = max_count, eps
+        self._loc = None  # data parallel: rank-local (mean, var, count), see ddp.prepare_norms (not part of the state_dict)
 
     # InstantTrack: when true, the freeze test runs on the GPU (torch.where) instead of a host-side `if`
     no_sync: bool = False
@@ -37,6 +39,21 @@ class RunningNorm(nn.Module):
     @torch.no_grad()
     def update(self, x: torch.Tensor):
         x = x.reshape(-1, x.shape[-1]).float()
+        if self._loc is not None:
+            # data parallel: accumulate into rank-local statistics only (no collective here: this runs inside captured CUDA
+            # graphs); ddp.sync_norms pools them into mean/var/count outside the graphs
+            mean0, var0, count0 = self._loc
+            n = x.shape[0]
+            m, v = x.mean(0), x.var(0, unbiased=False)
+            tot = count0 + n
+            delta = m - mean0
+            mean = mean0 + delta * n / tot
+            var = (var0 * count0 + v * n + delta**2 * count0 * n / tot) / tot
+            live = count0 < self.max_count
+            mean0.copy_(torch.where(live, mean, mean0))
+            var0.copy_(torch.where(live, var, var0))
+            count0.copy_(torch.where(live, tot, count0))
+            return
         if not RunningNorm.no_sync and self.count >= self.max_count:
             return
         n = x.shape[0]
