@@ -0,0 +1,155 @@
+"""Data-parallel helpers for train.py. One process per GPU, each sees exactly one device (CUDA_VISIBLE_DEVICES, set by
+tools/launch_ddp.py), so every process keeps using "cuda:0". Everything is a no-op with WORLD == 1.
+
+What is synchronised (each rank has its own simulator, replay buffer and random stream):
+  * gradients of the world model, the policy and the critic: averaged before clipping and the optimizer step;
+  * RunningNorm statistics: accumulated rank-locally inside the graphs, pooled across ranks outside them (sync_norms);
+  * decisions that depend on rank-local numbers (LR-decay trigger, time budget): taken on rank 0 / max over ranks;
+  * parameters and buffers: broadcast from rank 0 at start and every --ddp_sync_every iterations (guards against drift).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import torch.distributed as dist
+
+WORLD = int(os.environ.get("WORLD_SIZE", "1"))
+RANK = int(os.environ.get("RANK", "0"))
+IS_MAIN = RANK == 0
+
+
+def init():
+    if WORLD == 1:
+        return
+    backend = os.environ.get("DDP_BACKEND", "nccl")
+    if backend == "nccl":
+        dist.init_process_group("nccl", device_id=torch.device("cuda:0"))
+    else:  # gloo: CPU tests only
+        dist.init_process_group(backend)
+    dist.all_reduce(torch.zeros(1, device="cuda:0" if backend == "nccl" else "cpu"))  # NCCL communicator before any graph capture
+
+
+def per_rank(n: int, what: str) -> int:
+    assert n % WORLD == 0, f"{what}={n} is not divisible by the number of ranks ({WORLD})"
+    return n // WORLD
+
+
+@torch.no_grad()
+def allreduce_grads(params):
+    """Average the gradients of ``params`` over the ranks (one flat all-reduce)."""
+    if WORLD == 1:
+        return
+    ps = [p for p in params if p.grad is not None]
+    flat = torch.cat([p.grad.reshape(-1) for p in ps])
+    dist.all_reduce(flat)
+    flat.mul_(1.0 / WORLD)
+    off = 0
+    for p in ps:
+        n = p.numel()
+        p.grad.copy_(flat[off : off + n].view_as(p.grad))
+        off += n
+
+
+def find_norms(*modules):
+    from blinkmimic.networks import RunningNorm
+
+    return [m for mod in modules for m in mod.modules() if isinstance(m, RunningNorm)]
+
+
+@torch.no_grad()
+def prepare_norms(norms):
+    """Give every RunningNorm rank-local accumulators (starting from the current, rank-identical statistics)."""
+    if WORLD == 1:
+        return
+    for n in norms:
+        n._loc = [n.mean.clone(), n.var.clone(), n.count.clone()]
+
+
+@torch.no_grad()
+def sync_norms(norms):
+    """Pool the ranks' local statistics into each norm's mean/var/count (in place; two small all-reduces for all norms).
+    Called outside CUDA graphs once per simulator step and once per policy update, so every rank normalises with identical,
+    at most one step old, statistics of all ranks' data."""
+    if WORLD == 1:
+        return
+    means = torch.cat([n._loc[0] for n in norms])
+    dist.all_reduce(means)
+    means.mul_(1.0 / WORLD)
+    var_in, off = [], 0
+    for n in norms:
+        k = n._loc[0].numel()
+        var_in.append(n._loc[1] + (n._loc[0] - means[off : off + k]) ** 2)  # within + between-rank variance
+        off += k
+    var_g = torch.cat(var_in)
+    dist.all_reduce(var_g)
+    var_g.mul_(1.0 / WORLD)
+    counts = torch.stack([n._loc[2] for n in norms])
+    dist.all_reduce(counts)  # sum: the pooled sample count
+    off = 0
+    for i, n in enumerate(norms):
+        k = n._loc[0].numel()
+        n.mean.copy_(means[off : off + k])
+        n.var.copy_(var_g[off : off + k])
+        n.count.copy_(counts[i])
+        off += k
+
+
+@torch.no_grad()
+def broadcast_state(modules, src: int = 0):
+    """Overwrite parameters and buffers of every module with rank ``src``'s values (in place)."""
+    if WORLD == 1:
+        return
+    ts = []
+    for m in modules:
+        ts += [t.data for t in list(m.parameters()) + list(m.buffers())]
+    flat = torch.cat([t.reshape(-1).float() for t in ts])
+    dist.broadcast(flat, src)
+    off = 0
+    for t in ts:
+        t.copy_(flat[off : off + t.numel()].view_as(t).to(t.dtype))
+        off += t.numel()
+
+
+@torch.no_grad()
+def max_param_diff(modules) -> float:
+    """Largest absolute parameter difference between any rank and rank 0 (0 when in sync)."""
+    if WORLD == 1:
+        return 0.0
+    flat = torch.cat([p.data.reshape(-1).float() for m in modules for p in m.parameters()])
+    ref = flat.clone()
+    dist.broadcast(ref, 0)
+    d = (flat - ref).abs().max()
+    dist.all_reduce(d, op=dist.ReduceOp.MAX)
+    return float(d)
+
+
+def any_rank(flag: bool) -> bool:
+    if WORLD == 1:
+        return flag
+    t = torch.tensor(float(flag), device="cuda:0" if dist.get_backend() == "nccl" else "cpu")
+    dist.all_reduce(t, op=dist.ReduceOp.MAX)
+    return bool(t.item())
+
+
+def from_main(flag: bool) -> bool:
+    if WORLD == 1:
+        return flag
+    t = torch.tensor(float(flag), device="cuda:0" if dist.get_backend() == "nccl" else "cpu")
+    dist.broadcast(t, 0)
+    return bool(t.item())
+
+
+def shutdown():
+    """End of training. With captured NCCL graphs, destroy_process_group / interpreter teardown can hang (observed on 2x T4), so
+    after a barrier and flushing the logs the process leaves with os._exit(0). Call it only when everything is saved."""
+    if WORLD == 1:
+        return
+    import sys
+
+    print(f"[rank {RANK}] training done, waiting at the barrier", flush=True)
+    dist.barrier()
+    print(f"[rank {RANK}] barrier passed, exiting", flush=True)
+    sys.stdout.flush(), sys.stderr.flush()
+    os._exit(0)
